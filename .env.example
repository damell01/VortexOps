APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail Configuration
# Supported drivers: log, smtp, resend, postmark, ses
# Local default is `log` — mail is written to storage/logs/laravel.log and
# never leaves the machine. Production uses Resend: set MAIL_MAILER=resend and
# RESEND_API_KEY below, then check it with `php artisan mail:test`.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Resend Email Service (https://resend.com)
RESEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Scraper API Token (used by desktop collector to post show data)
SCRAPER_API_TOKEN=

# Whatnot seller dashboard scraper
WHATNOT_EMAIL=
WHATNOT_PASSWORD=
WHATNOT_IMPORT_LIMIT=50
# Browser backend: local (Node/Playwright), scrapling (Python Scrapling
# StealthySession + persistent profile), or steel (self-hosted Steel Browser).
# WHATNOT_BROWSER_BACKEND=scrapling
# WHATNOT_PYTHON_BIN=python3
# Scrapling backend: use its built-in Cloudflare handling and fail closed if a
# challenge is still visible when the page is returned. Retries are bounded.
# WHATNOT_SCRAPLING_SOLVE_CLOUDFLARE=true
# WHATNOT_SCRAPLING_BLOCK_WEBRTC=true
# WHATNOT_SCRAPLING_HIDE_CANVAS=true
# WHATNOT_SCRAPLING_RETRIES=2
# WHATNOT_SCRAPLING_RETRY_DELAY=2
# Scrapling failures may fall back to Playwright, but login/channel-context
# failures (exit 3) always fail closed and never fall through to another account.
# WHATNOT_SCRAPER_FALLBACK=1
# Multi-channel runs: each channel gets its own browser profile, cookies file,
# and diagnostics directory under WHATNOT_STATE_DIR/<channel>/.
# WHATNOT_CHANNELS=JMOCKS,TCGPIRATES
# WHATNOT_STATE_DIR=/var/www/vortexops/storage/whatnot-channels
# WHATNOT_CHANNEL_ISOLATE=1
# Run with: npm run whatnot:multi
# A first-time isolated channel profile may need a one-time authenticated login.
# WHATNOT_SCRAPLING_DIAGNOSTICS_DIR=/var/www/vortexops/storage/logs/whatnot-scrapling
# STEEL_BASE_URL=http://127.0.0.1:3000
# WHATNOT_NODE_BIN=node
# Set false to pause every scheduled whatnot:* job — they share one browser
# profile behind one lock, so a scheduled run blocks any manual one. Backups,
# health checks and reports keep running.
# WHATNOT_SCHEDULE_ENABLED=true
# Headless remains optional. Headed Linux runs are wrapped with scripts/with-xvfb.sh.
# WHATNOT_HEADLESS=false
# Optional egress setting for the existing Node/Steel engines.
# WHATNOT_PROXY=
