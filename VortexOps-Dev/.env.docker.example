# ─────────────────────────────────────────────────────────────────────────────
# VortexOps — Docker / Production environment
# Copy this file to .env.docker and fill in every value marked CHANGE_ME.
# .env.docker is git-ignored and never committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=VortexOps
APP_ENV=production
APP_KEY=                          # CHANGE_ME — run: php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://your-domain.com   # CHANGE_ME
APP_OWNER_EMAIL=dbellcreations@gmail.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ── Docker image ──────────────────────────────────────────────────────────────
# On the VPS this tells docker compose which image to pull from GHCR.
# Local dev: leave blank or set to vortexops:local after running `docker compose build`.
APP_IMAGE=ghcr.io/damell01/vortexops:latest

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# ── Database ──────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=vortexops
DB_USERNAME=vortexops
DB_PASSWORD=CHANGE_ME_DB_PASSWORD       # CHANGE_ME — use a strong random password
DB_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD # CHANGE_ME — separate strong password for root

RUN_MIGRATIONS=true

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

# ── Session / Cache ───────────────────────────────────────────────────────────
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=redis

# ── Queue ─────────────────────────────────────────────────────────────────────
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

# ── Filesystem ────────────────────────────────────────────────────────────────
FILESYSTEM_DISK=public

# ── Whatnot scraper ───────────────────────────────────────────────────────────
# The scraper runs Playwright (Node.js + Chromium) inside the app container.
# Both env vars below are required for whatnot:import to work.
WHATNOT_EMAIL=CHANGE_ME@example.com  # CHANGE_ME — your Whatnot seller account email
WHATNOT_PASSWORD=CHANGE_ME           # CHANGE_ME — Whatnot account password
WHATNOT_LIMIT=50
# Playwright/Chromium location — matches the path baked into the Docker image.
PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers

# ── Ollama AI (packing-slip scanner) ─────────────────────────────────────────
# Only used when running with --profile ai (docker compose --profile ai up).
# Both models are auto-pulled on first Ollama container start.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b          # text/general model
OLLAMA_VISION_MODEL=moondream     # vision model for packing slip scanning
OLLAMA_TIMEOUT=60

# ── Mail ─────────────────────────────────────────────────────────────────────
# Use log for development; set to smtp/sendmail for production.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Misc ──────────────────────────────────────────────────────────────────────
SCRAPER_API_TOKEN=CHANGE_ME_SCRAPER_TOKEN  # CHANGE_ME — used for internal API auth
