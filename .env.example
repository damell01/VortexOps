APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# The single super-user: module toggles, roles, and the owner-only pages.
# Leave blank to fall back to dbellcreations@gmail.com.
APP_OWNER_EMAIL=dbellcreations@gmail.com
DEVELOPER_EMAIL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
# Set to true if your host caps new connections per hour (e.g. Hostinger's
# max_connections_per_hour) and you're hitting that limit under normal
# traffic — reuses one connection per PHP-FPM worker instead of opening a
# fresh one on every request.
# DB_PERSISTENT=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to .yourdomain.com (leading dot) to share sessions across subdomains
# e.g. SESSION_DOMAIN=.bellflowapp.com

# Optional: serve the review portal from a subdomain instead of /review path
# e.g. REVIEW_DOMAIN=review.bellflowapp.com
REVIEW_DOMAIN=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:2b
OLLAMA_VISION_MODEL=moondream
OLLAMA_TIMEOUT=120

# ADP Payroll Export
ADP_COMPANY_CODE=VB
ADP_EARNINGS_CODE=REG

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail Configuration
# Supported drivers: log, smtp, resend, postmark, ses
# For production, use resend with RESEND_API_KEY
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Resend Email Service (https://resend.com)
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Scraper API Token (used by Playwright scraper to post show data)
SCRAPER_API_TOKEN=

# Whatnot seller dashboard scraper
WHATNOT_EMAIL=
WHATNOT_PASSWORD=
WHATNOT_IMPORT_LIMIT=50
# WHATNOT_NODE_BIN=node  # override if node is not on PATH
# Set false to pause every scheduled whatnot:* job — they share one browser
# profile behind one lock, so a scheduled run blocks any manual one. Backups,
# health checks and reports keep running.
# WHATNOT_SCHEDULE_ENABLED=true
# How long to wait for a Cloudflare interstitial to clear before giving up (ms).
# WHATNOT_CHALLENGE_WAIT_MS=45000
# Headless Chromium is the loudest bot signal there is. Set false and run under
# xvfb-run (apt-get install -y xvfb) when Cloudflare challenges the browser
# rather than the session — i.e. a challenge on a page that is not /login.
# WHATNOT_HEADLESS=true

