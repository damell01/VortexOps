{
  "name": "vortex-whatnot-sync",
  "version": "0.2.0",
  "private": true,
  "description": "VortexOps Whatnot desktop sync companion",
  "main": "app/main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.vortexops.whatnotsync",
    "productName": "Vortex Whatnot Sync",
    "asar": false,
    "files": [
      "app/**/*",
      "collector/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "collector",
        "to": "collector"
      },
      {
        "from": "runtime",
        "to": "runtime"
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "VortexWhatnotSync-${version}.exe"
    }
  }
}