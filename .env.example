APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail Configuration
# Supported drivers: log, smtp, resend, postmark, ses
# Local default is `log` — mail is written to storage/logs/laravel.log and
# never leaves the machine. Production uses Resend: set MAIL_MAILER=resend and
# RESEND_API_KEY below, then check it with `php artisan mail:test`.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Resend Email Service (https://resend.com)
RESEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Scraper API Token (used by desktop collector to post show data)
SCRAPER_API_TOKEN=

# Whatnot seller dashboard scraper
WHATNOT_EMAIL=
WHATNOT_PASSWORD=
WHATNOT_IMPORT_LIMIT=50
# Browser backend: local (Node/Playwright), scrapling (Python DynamicSession),
# steel (self-hosted Steel Browser), or http-health (diagnostic-only HTTP probe).
# WHATNOT_BROWSER_BACKEND=scrapling
# WHATNOT_PYTHON_BIN=python3
# Scrapling application runs use the ordinary DynamicSession implementation.
# Challenge-solving/Turnstile handling is not selected by the application runner.
# WHATNOT_SCRAPER_FALLBACK=1
# Fallback is only for ordinary backend/runtime failures. Login/channel mismatch,
# rate limiting, or an explicitly detected anti-bot challenge fail closed.
#
# Optional HTTP session-health preflight. This borrows only the safe lifecycle
# ideas from the cloudscraper fork (session age, request counters, ordinary-403
# refresh, diagnostics). It does not enable Cloudflare/Turnstile solving,
# fingerprint rotation, stealth, proxy rotation, or token manipulation.
# WHATNOT_HTTP_PREFLIGHT=1
# WHATNOT_HTTP_PREFLIGHT_STRICT=0
# WHATNOT_HTTP_TIMEOUT=20
# WHATNOT_HTTP_SESSION_REFRESH=3600
# WHATNOT_HTTP_RETRY_DELAY=1.5
# WHATNOT_HTTP_HEALTH_URL=https://www.whatnot.com/dashboard/home
# WHATNOT_HTTP_DIAGNOSTICS_DIR=/var/www/vortexops/storage/logs/whatnot-http
# Run only the health adapter with: npm run whatnot:http-health
#
# Multi-channel runs: each channel gets its own browser profile, cookies file,
# and diagnostics directory under WHATNOT_STATE_DIR/<channel>/.
# WHATNOT_CHANNELS=JMOCKS,TCGPIRATES
# WHATNOT_STATE_DIR=/var/www/vortexops/storage/whatnot-channels
# WHATNOT_CHANNEL_ISOLATE=1
# Run with: npm run whatnot:multi
# A first-time isolated channel profile may need a one-time authenticated login.
# WHATNOT_SCRAPLING_DIAGNOSTICS_DIR=/var/www/vortexops/storage/logs/whatnot-scrapling
# STEEL_BASE_URL=http://127.0.0.1:3000
# WHATNOT_NODE_BIN=node
# Set false to pause every scheduled whatnot:* job — they share one browser
# profile behind one lock, so a scheduled run blocks any manual one. Backups,
# health checks and reports keep running.
# WHATNOT_SCHEDULE_ENABLED=true
# Headless remains optional. Headed Linux runs are wrapped with scripts/with-xvfb.sh.
# WHATNOT_HEADLESS=false
# Optional egress setting for the existing Node/Steel engines.
# WHATNOT_PROXY=

# Development-only Cloudflare test harness for infrastructure you own or are
# explicitly authorized to test. This harness is separate from Whatnot and
# refuses whatnot.com targets.
# ALLOW_OWNED_TEST_TARGET=1
# TEST_TARGET_URL=https://your-test-domain.example/
# TEST_TARGET_SOLVE_CLOUDFLARE=true
# TEST_TARGET_BLOCK_WEBRTC=true
# TEST_TARGET_HIDE_CANVAS=true
# TEST_TARGET_HEADLESS=true
# Run with: npm run test:cloudflare
